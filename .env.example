NODE_ENV=development
PORT=4000
API_PREFIX=/v1
LOG_LEVEL=info

# MongoDB. A new database name, so data from the earlier InsureHub build (database "insurehub") is untouched.
# A standalone server works for local testing; records that belong together are then written one after another.
# For real transactions (required in production), run MongoDB as a single-node replica set (see README).
MONGO_URI=mongodb://127.0.0.1:27017/bimayantra
# MONGO_REQUIRE_TRANSACTIONS=false

# Two Redis instances: cache (allkeys-lru) and queue (noeviction, for the job queue).
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=bimayantra-api
JWT_AUDIENCE=bimayantra-clients

# Browsers allow Secure cookies on http://localhost, but set false if your browser refuses them locally.
COOKIE_SECURE=false

# OTP hash pepper (32+ chars) and the two PAN/Aadhaar keys (32 bytes, base64). Generate keys with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_AAAAAAAAAAA=
PII_HASH_KEY=REPLACE_WITH_ANOTHER_32_BYTE_BASE64_KEY_AAAA=

# 'dev' = OTP SMS go to the test inbox shown in the web console (never in production).
# SMS: dev (test inbox) or msg91. MSG91: DLT entity + sender ID + an OTP template approved on DLT and added in MSG91
# (OTP section; the template text uses ##OTP##). MSG91_OTP_TEMPLATE_ID is that MSG91 template id. Optional: a DLT SMS
# template for the login-number-changed notice with variables masked_mobile and support.
SMS_PROVIDER=dev
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=

# Test tools for the web console: SMS inbox, test clock, configuration overrides. Never in production.
DEV_TOOLS=true

# Private file storage (KYC documents, photos, logos, PDFs).
#   local      = ./storage on this machine (development only)
#   cloudinary = private Cloudinary assets (decision Q29). Check with: npm run storage:check
FILE_STORAGE=local
FILE_STORAGE_DIR=./storage
# Cloudinary console -> Settings -> API Keys. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep development and production apart. Production refuses a folder ending in -dev.
CLOUDINARY_FOLDER=bimayantra-dev
# Only if Cloudinary assigns your account a regional API host:
# CLOUDINARY_UPLOAD_PREFIX=https://api-ap.cloudinary.com

TERMS_VERSION=2026-10-v1
SUPPORT_EMAIL=support@bimayantra.in

CORS_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=100kb

# First SkyUp Admin, created by `npm run seed:admin`. Sign in with this mobile number and the OTP.
SEED_ADMIN_NAME=SkyUp Admin
SEED_ADMIN_MOBILE=9900000000

# Automatic reading of Aadhaar, PAN and old policies (P-18). none = manual entry only.
# google = Google Document AI, plain OCR processor in Mumbai. Check with: npm run ocr:check <file> PAN
DOCUMENT_READER=none
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=asia-south1
DOCUMENT_AI_PROCESSOR_ID=
# Path to the service-account key (.json). Keep it OUTSIDE the project folder; never commit it.
DOCUMENT_AI_KEY_FILE=

# The address customers open quotation links on (P-28): https://app.bimayantra.com in production.
PUBLIC_APP_URL=http://localhost:5173

# Communications (Section 15). 'dev' keeps messages in a test inbox (non-production only).
# WhatsApp: dev or msg91. MSG91: integrate the WhatsApp Business number in MSG91 (MSG91_WA_NUMBER, with 91).
# Templates are created at MSG91 for Meta's review automatically (built-in ones on first start, new ones when
# published in Admin → Message templates); messages wait until Meta approves. Webhook in MSG91 (WhatsApp → Webhook):
#   https://<PUBLIC_API_URL host>/v1/webhooks/msg91/<MSG91_WEBHOOK_TOKEN>   (delivery reports and inbound messages)
WHATSAPP_PROVIDER=dev
MSG91_WA_NUMBER=
MSG91_WEBHOOK_TOKEN=
# Email: dev (test inbox) or brevo. Brevo: create an API key (SMTP & API → API keys), verify the sender
# (Senders & IP) and authenticate the domain (SPF/DKIM). Add a transactional webhook to
#   https://<PUBLIC_API_URL host>/v1/webhooks/brevo/<BREVO_WEBHOOK_TOKEN>
# with the events delivered, opened, hard bounce, invalid email, blocked, spam, unsubscribed, error.
EMAIL_PROVIDER=dev
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Bimayantra
EMAIL_REPLY_TO=
# Payments: dev or razorpay. Razorpay: Settings → API keys (rzp_test_… for staging, rzp_live_… for production).
# Webhook (Settings → Webhooks): URL https://<PUBLIC_API_URL host>/v1/webhooks/razorpay, events payment.captured and
# order.paid, secret = RAZORPAY_WEBHOOK_SECRET. Turn on automatic capture (payments are also captured by the API).
PAYMENT_GATEWAY=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_DISPLAY_NAME=Bimayantra
# Webhook signatures (HMAC-SHA256 of the raw body, header X-Bimayantra-Signature). Set a long random value in production.
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Campaigns (Module 17): the public address of this API, shown as the webhook URL for Google Ads and websites.
PUBLIC_API_URL=http://localhost:4000

# Campaigns: Meta Lead Ads (needs Meta App Review). Leave empty until the client's app is approved.
META_APP_ID=
META_APP_SECRET=
# Any long random text; paste the same value in the Meta app's Webhooks settings.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v22.0
# Campaigns: LinkedIn Lead Gen Forms (needs LinkedIn Lead Sync API access).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
# Where the platforms send the browser back after sign-in (the web app).

# Campaigns, Stage H: Google Ads campaign status and spend (needs a Google Ads API developer token). Leads already
# arrive by the lead-form webhook without these. GOOGLE_ADS_LOGIN_CUSTOMER_ID only when signing in through a manager account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25